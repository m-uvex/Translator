{
 "name": "uebersetzer",
 "version": "1.15.155",
 "private": true,
 "description": "Lokaler Übersetzer und Texteditor mit Ollama, NLLB-200, HY-MT, MiLMMT-46 und TranslateGemma",
 "author": "Janek",
 "main": "main.js",
 "scripts": {
  "start": "electron .",
  "dist": "electron-builder --win nsis",
  "dist:win": "electron-builder --win nsis",
  "dist:linux": "electron-builder --linux AppImage deb rpm tar.gz"
 },
 "dependencies": {
  "dictionary-de": "^3.0.0",
  "dictionary-en": "^4.0.0",
  "dictionary-es": "^4.0.0",
  "dictionary-nl": "^2.0.0",
  "dictionary-tr": "^2.0.0",
  "electron": "^33.0.0",
  "hunspell-wasm": "^0.3.0",
  "jszip": "^3.10.2",
  "mammoth": "^1.13.0",
  "pdf-parse": "^2.4.5"
 },
 "devDependencies": {
  "electron-builder": "^25.0.0"
 },
 "build": {
  "appId": "local.uebersetzer",
  "productName": "Übersetzer",
  "files": [
   "*.js",
   "*.html",
   "*.css",
   "*.py",
   "requirements.txt",
   "build/icon.ico",
   "build/icon.png",
   "dict/**",
   "node_modules/**"
  ],
  "asarUnpack": [
   "nllb_server.py",
   "requirements.txt",
   "dict/**",
   "build/icon.png",
   "node_modules/hunspell-wasm/**"
  ],
  "extraResources": [
   "install.ps1"
  ],
  "nsis": {
   "oneClick": true,
   "perMachine": false,
   "createDesktopShortcut": "always",
   "createStartMenuShortcut": true
  },
  "linux": {
   "target": [
    "AppImage",
    "deb",
    "rpm",
    "tar.gz"
   ],
   "executableName": "uebersetzer",
   "category": "Utility",
   "icon": "build/icon.png",
   "maintainer": "Janek",
   "synopsis": "Lokaler Übersetzer und Texteditor",
   "description": "Lokaler Übersetzer und Texteditor mit Ollama, NLLB-200, HY-MT, MiLMMT-46 und TranslateGemma; läuft vollständig offline.",
   "desktop": {
    "entry": {
     "Name": "Übersetzer",
     "Comment": "Lokaler Übersetzer und Texteditor",
     "Categories": "Utility;TextTools;",
     "Keywords": "übersetzen;übersetzer;editor;offline;",
     "StartupWMClass": "uebersetzer"
    }
   }
  }
 }
}
